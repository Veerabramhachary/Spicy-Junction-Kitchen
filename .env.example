

# APP_URL: The absolute URL this app is served from.
# Used for canonical links, OpenGraph tags and the schema.org JSON-LD block.
APP_URL="http://localhost:3000"

# Optional: Google Apps Script Web App URLs for Google Sheets tracking.
# These are SEPARATE on purpose - orders and bookings have different column
# layouts, so each points at its own Apps Script / sheet tab.
# Deploy the script with access set to "Anyone", then paste the /exec URL here.
ORDER_GOOGLE_SHEETS_WEBHOOK_URL=""
BOOKING_GOOGLE_SHEETS_WEBHOOK_URL=""

# Optional: Webhook URL (Zapier, Make, Formspree, n8n) for order notifications
ORDER_WEBHOOK_URL=""